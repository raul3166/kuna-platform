# ========================================================
# KUNA PLATFORM - Environment Variables Template
# ========================================================

# Puerto expuesto para PostgreSQL en la máquina host
# (5433 por defecto si ya tienes Postgres local corriendo en el puerto 5432.
#  En una máquina limpia donde el 5432 esté libre, puedes colocar 5432).
DB_HOST_PORT=5433

# Credenciales de Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Kuna2026!
POSTGRES_DB=kuna

# Puerto de la API NestJS
API_PORT=3000

# Puerto del Frontend Web Vue 3
WEB_PORT=5173

# Seguridad JWT
JWT_SECRET=KUNA_DEVELOPMENT_SECRET_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=1d

# URL de la API consumida por el Frontend (en el navegador del cliente)
VITE_API_URL=http://localhost:3000

