generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  CUSTOMER_RETURN
  SERVICE_CONSUMPTION
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH // Efectivo
  CREDIT_CARD // Tarjeta de Crédito
  DEBIT_CARD // Tarjeta de Débito
  TRANSFER // Transferencia bancaria (Ej: Nequi, Daviplata, Pix)
  CREDIT // Crédito comercial / Cuenta por cobrar
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_PRINTED
  RESERVED
}

enum KitchenStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum TaxType {
  VAT // IVA
  CONSUMPTION // INC (Impuesto Nacional al Consumo)
  WITHHOLDING // Retenciones (ReteFuente, ReteIVA, ReteICA)
}

enum GoodsReceiptStatus {
  DRAFT
  PROCESSED
  CANCELLED
}

enum ServiceOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  BILLED
  CANCELLED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  VAN
  TRUCK
  OTHER
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}

// ============================================================
// ESTRUCTURA IMPUESTOS
// ============================================================

model TaxRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String // Ej: "IVA General 19%", "INC 8%", "ReteFuente Compras 2.5%"
  code           String // Ej: "IVA_19", "INC_8", "RET_25"
  type           TaxType
  percentage     Decimal      @db.Decimal(5, 2)
  isRetention    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
}

// ============================================================
// ESTRUCTURA ORGANIZACIONAL
// ============================================================

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  country              String
  timezone             String                @default("America/Bogota")
  isActive             Boolean               @default(true)
  branches             Branch[]
  users                User[]
  roles                Role[]
  customers            Customer[]
  suppliers            Supplier[]
  products             Product[]
  productCategories    ProductCategory[]
  inventoryMovements   InventoryMovement[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  inventoryTransfers   InventoryTransfer[]
  sales                Sale[]
  saleReturns          SaleReturn[]
  payments             Payment[]
  billingResolutions   BillingResolution[]
  cashSessions         CashSession[]
  rooms                Room[]
  taxes                TaxRule[]
  gymMembershipPlans   GymMembershipPlan[]
  gymSubscriptions     GymSubscription[]
  gymAttendanceLogs    GymAttendanceLog[]
  gymSchedules         GymSchedule[]
  studioPlans          StudioPlan[]
  studioSubscriptions  StudioSubscription[]
  studioAttendanceLogs StudioAttendanceLog[]
  studioSchedules      StudioSchedule[] // <-- AGREGAR ESTA LÍNEA
  instructors          Instructor[]
  serviceWorkers       ServiceWorker[]
  serviceItems         ServiceItem[]
  serviceOrders        ServiceOrder[]
  hotelReservations    HotelReservation[]
  hotelRooms           HotelRoom[]
  internalConsumptions InternalConsumption[]
  organizationVerticals OrganizationVertical[]
  vehicles             Vehicle[]
  vehicleCheckIns      VehicleCheckIn[]
  appointments         Appointment[]
  appointmentItems     AppointmentItem[]
  beautyNotes          BeautyClientNote[]
  beautyWorkerSchedules BeautyWorkerSchedule[]
  beautyTimeOffs       BeautyTimeOff[]
  pets                 Pet[]
  vetMedicalRecords    VetMedicalRecord[]
  petVaccinations      PetVaccination[]
  laundryTickets       LaundryTicket[]
  bakeryRecipes        BakeryRecipe[]
  bakeryProductionOrders BakeryProductionOrder[]
  academyCourses       AcademyCourse[]
  academyCohorts       AcademyCohort[]
  academyEnrollments   AcademyEnrollment[]
  academyAttendances   AcademyAttendance[]
  realEstateProperties RealEstateProperty[]
  realEstateLeases     RealEstateLease[]
  realEstateRentCharges RealEstateRentCharge[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  code        String
  address     String
  city        String
  country     String
  phoneNumber String?
  timezone    String

  users         User[]
  productStocks BranchProductStock[]

  sourceTransfers      InventoryTransfer[] @relation("TransferSourceBranch")
  destinationTransfers InventoryTransfer[] @relation("TransferDestinationBranch")

  inventoryMovements   InventoryMovement[]
  sales                Sale[]
  saleReturns          SaleReturn[]
  billingResolutions   BillingResolution[]
  cashSessions         CashSession[]
  rooms                Room[]
  purchaseOrders       PurchaseOrder[]
  productLots          ProductLot[]
  gymMembershipPlans   GymMembershipPlan[]
  gymSubscriptions     GymSubscription[]
  gymAttendanceLogs    GymAttendanceLog[]
  gymSchedules         GymSchedule[]
  studioPlans          StudioPlan[]
  studioSubscriptions  StudioSubscription[]
  studioAttendanceLogs StudioAttendanceLog[]
  studioSchedules      StudioSchedule[] // <-- AGREGAR ESTA LÍNEA
  instructors          Instructor[]
  serviceWorkers       ServiceWorker[]
  serviceOrders        ServiceOrder[]
  hotelReservations    HotelReservation[]
  hotelRooms           HotelRoom[]
  internalConsumptions InternalConsumption[]
  vehicleCheckIns      VehicleCheckIn[]
  appointments         Appointment[]
  beautyWorkerSchedules BeautyWorkerSchedule[]
  vetMedicalRecords    VetMedicalRecord[]
  petVaccinations      PetVaccination[]
  laundryTickets       LaundryTicket[]
  bakeryProductionOrders BakeryProductionOrder[]
  academyCohorts       AcademyCohort[]
  academyEnrollments   AcademyEnrollment[]
  realEstateProperties RealEstateProperty[]
  realEstateLeases     RealEstateLease[]
  realEstateRentCharges RealEstateRentCharge[]
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, code])
}

// ============================================================
// PROVEEDORES Y PRODUCTOS
// ============================================================

model Supplier {
  id             String @id @default(cuid())
  organizationId String

  companyName          String
  contactName          String?
  identificationType   String
  identificationNumber String
  email                String?
  phoneNumber          String?
  address              String?
  city                 String?
  state                String?
  country              String?
  notes                String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  organization     Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, identificationNumber])
}

model Product {
  id             String @id @default(cuid())
  organizationId String

  sku         String
  name        String
  description String?
  barcode     String?

  salePrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)
  stock     Decimal @default(0) @db.Decimal(12, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId           String?
  supplierId           String?
  taxRuleId            String?
  studioPlan           StudioPlan?
  inventoryMovements   InventoryMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  branchStocks         BranchProductStock[]
  inventoryTransfers   InventoryTransfer[]
  items                SaleItem[]
  returnItems          SaleReturnItem[]
  restaurantOrderItems RestaurantOrderItem[] // <--- NUEVA RELACIÓN
  hotelRoomCharges     HotelRoomCharge[]
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])
  taxRule      TaxRule?     @relation(fields: [taxRuleId], references: [id])

  // === NUEVAS RELACIONES DE EXTENSIÓN ===
  pharmaDetail      ProductPharma?
  lots              ProductLot[]
  gymMembershipPlan GymMembershipPlan?
  serviceMaterials  ServiceOrderMaterial[]
  serviceItems       ServiceItem[] // Relación con los servicios que utilizan este producto como material
  petVaccinations   PetVaccination[]
  bakeryRecipesAsFinished BakeryRecipe[] @relation("BakeryFinishedProduct")
  bakeryRecipeIngredients BakeryRecipeIngredient[] @relation("BakeryIngredientProduct")
  bakeryProductionOrders  BakeryProductionOrder[] @relation("BakeryProductionFinishedProduct")

  @@unique([organizationId, sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([taxRuleId])
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  trackStock     Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products     Product[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================
// INVENTARIOS Y COMPRAS
// ============================================================

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  productId      String
  branchId       String?
  serviceOrderId String?
  movementType   InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  unitCost       Decimal?              @db.Decimal(12, 2)
  totalCost      Decimal?              @db.Decimal(14, 2)
  reference      String?
  notes          String?
  internalConsumptionId String?
  createdAt      DateTime              @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  internalConsumption   InternalConsumption? @relation(fields: [internalConsumptionId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([branchId])
  @@index([serviceOrderId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime
  expectedDate   DateTime?
  notes          String?
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  tax            Decimal             @default(0) @db.Decimal(12, 2)
  total          Decimal             @default(0) @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal @db.Decimal(18, 4)
  unitCost        Decimal @db.Decimal(18, 4)
  subtotal        Decimal @db.Decimal(18, 4)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceiptItems GoodsReceiptItem[]
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  number          String
  receivedDate    DateTime
  receivedById    String?
  status          GoodsReceiptStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User?         @relation(fields: [receivedById], references: [id])

  items            GoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([receivedById])
}

model GoodsReceiptItem {
  id                  String  @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityReceived    Decimal @db.Decimal(18, 4)
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReturnItems PurchaseReturnItem[]
  goodsReceipt        GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem   PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product              @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([productId])
}

model PurchaseInvoice {
  id              String                @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String?
  goodsReceiptId  String?
  number          String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          PurchaseInvoiceStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id])
  items         PurchaseInvoiceItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseInvoiceItem {
  id                String  @id @default(cuid())
  purchaseInvoiceId String
  productId         String
  quantity          Decimal @db.Decimal(18, 4)
  unitCost          Decimal @db.Decimal(18, 4)
  taxRate           Decimal @default(0) @db.Decimal(5, 2)
  subtotal          Decimal @db.Decimal(18, 4)
  total             Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model PurchaseReturn {
  id              String               @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String
  goodsReceiptId  String?
  number          String
  returnDate      DateTime
  status          PurchaseReturnStatus @default(DRAFT)
  reason          String?
  notes           String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id])
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id])
  items         PurchaseReturnItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseReturnItem {
  id                 String  @id @default(cuid())
  purchaseReturnId   String
  goodsReceiptItemId String
  productId          String
  quantity           Decimal @db.Decimal(18, 4)
  unitCost           Decimal @db.Decimal(18, 4)
  subtotal           Decimal @db.Decimal(18, 4)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReturn   PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id])
  goodsReceiptItem GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@index([goodsReceiptItemId])
  @@index([productId])
}

model BranchProductStock {
  id          String  @id @default(cuid())
  branchId    String
  productId   String
  stock       Decimal @default(0) @db.Decimal(12, 3)
  averageCost Decimal @default(0) @db.Decimal(12, 2)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model InventoryTransfer {
  id                  String  @id @default(cuid())
  organizationId      String
  productId           String
  sourceBranchId      String
  destinationBranchId String
  quantity            Decimal @db.Decimal(12, 3)
  reference           String
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])
  sourceBranch      Branch       @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id])
  destinationBranch Branch       @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([productId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
}

// ============================================================
// MÓDULO RESTAURANTE (AMBIENTES, MESAS Y COMANDAS)
// ============================================================

model Room {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tables       RestaurantTable[]
  organization Organization      @relation(fields: [organizationId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([branchId])
}

model RestaurantTable {
  id             String      @id @default(cuid())
  roomId         String
  tableNumber    String
  capacity       Int
  status         TableStatus @default(AVAILABLE)
  currentOrderId String? // Vincula la comanda/orden activa de cocina
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  room         Room              @relation(fields: [roomId], references: [id])
  currentOrder RestaurantOrder?  @relation("ActiveTableOrder", fields: [currentOrderId], references: [id])
  orders       RestaurantOrder[] @relation("TableOrderHistory")
  sales        Sale[]            @relation("TableSales")

  @@index([roomId])
  @@index([currentOrderId])
}

model RestaurantOrder {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  tableId        String
  status         KitchenStatus @default(PENDING)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vinculación opcional con la venta al momento de cobrar la mesa
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  table         RestaurantTable       @relation("TableOrderHistory", fields: [tableId], references: [id])
  activeOnTable RestaurantTable[]     @relation("ActiveTableOrder")
  items         RestaurantOrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
}

model RestaurantOrderItem {
  id                String          @id @default(cuid())
  restaurantOrderId String
  restaurantOrder   RestaurantOrder @relation(fields: [restaurantOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12, 2)
  notes             String?         @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantOrderId])
  @@index([productId])
}

// ============================================================
// VENTAS Y FACTURACIÓN (NÚCLEO FINANCIERO GENÉRICO)
// ============================================================

model Sale {
  id             String     @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String?
  tableId        String? // Opcional para guardar referencia histórica de la mesa
  orderId        String?    @unique
  saleNumber     String
  status         SaleStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes       String?
  items       SaleItem[]
  saleReturns SaleReturn[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  branch          Branch            @relation(fields: [branchId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  table           RestaurantTable?  @relation("TableSales", fields: [tableId], references: [id])
  restaurantOrder RestaurantOrder? // Relación inversa opcional con la orden de cocina
  serviceOrder    ServiceOrder?
  hotelReservation HotelReservation?
  serviceItems    SaleServiceItem[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([tableId])
  @@index([status])
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  productId     String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  description   String?  @db.VarChar(255)
  taxPercentage Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items   SaleReturnItem[]
  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  saleId         String
  customerId     String?

  returnNumber String
  status       SaleReturnStatus @default(DRAFT)
  returnDate   DateTime

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  reason String? @db.VarChar(255)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch           @relation(fields: [branchId], references: [id])
  sale         Sale             @relation(fields: [saleId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id])
  items        SaleReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([saleId])
}

model SaleReturnItem {
  id           String  @id @default(cuid())
  saleReturnId String
  saleItemId   String
  productId    String
  quantity     Int
  unitCost     Decimal @db.Decimal(12, 2)
  notes        String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
}

model Payment {
  id             String @id @default(cuid())
  organizationId String
  saleId         String

  method      PaymentMethod @default(CASH)
  amount      Decimal       @db.Decimal(12, 2)
  reference   String?       @db.VarChar(100)
  paymentDate DateTime      @default(now())
  notes       String?       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([saleId])
}

model BillingResolution {
  id             String @id @default(cuid())
  organizationId String
  branchId       String @unique

  prefix           String   @db.VarChar(15)
  resolutionNumber String   @db.VarChar(50)
  fromNumber       Int
  toNumber         Int
  currentNumber    Int
  expiryDate       DateTime

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId])
}

model CashSession {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  userId         String

  status      CashSessionStatus @default(OPEN)
  openingDate DateTime          @default(now())
  closingDate DateTime?

  openingBalance  Decimal  @db.Decimal(12, 2)
  expectedBalance Decimal  @default(0) @db.Decimal(12, 2)
  actualBalance   Decimal? @db.Decimal(12, 2)
  difference      Decimal? @db.Decimal(12, 2)

  notes     String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
}

// ============================================================
// EXTENSIÓN PARA DROGUERÍA / FARMACIA (Relación 1 a 1 con Product)
// ============================================================

model ProductPharma {
  id                   String  @id @default(cuid())
  productId            String  @unique
  activeIngredient     String? // Principio activo (ej. Acetaminofén)
  laboratory           String? // Laboratorio (ej. Genfar, MK)
  invimaCode           String? // Registro Sanitario INVIMA
  requiresPrescription Boolean @default(false) // Requiere fórmula médica
  concentration        String? // Ej. 500mg, 10ml

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONTROL DE LOTES Y VENCIMIENTOS (FEFO)
// ============================================================

model ProductLot {
  id             String   @id @default(cuid())
  productId      String
  branchId       String
  lotNumber      String // Código o número de lote
  expirationDate DateTime // Fecha de vencimiento
  stock          Decimal  @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId, lotNumber])
  @@index([productId])
  @@index([branchId])
  @@index([expirationDate])
}

// ============================================================
// MÓDULO DE SERVICIOS / ÓRDENES DE TRABAJO
// ============================================================

enum EmploymentType {
  SALARIED
  COMMISSION
}

model ServiceWorker {
  id                   String         @id @default(cuid())
  organizationId       String
  branchId             String?
  firstName            String
  lastName             String?
  identification       String
  phoneNumber          String?
  email                String?
  specialty            String?
  employmentType       EmploymentType @default(SALARIED)
  commissionPercentage Decimal        @default(0) @db.Decimal(5, 2)
  fixedSalary          Decimal        @default(0) @db.Decimal(12, 2)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders ServiceOrder[]     @relation("ServiceOrderAssignedWorker")
  assignedTasks  ServiceOrderTask[] @relation("ServiceTaskAssignedWorker")
  appointments   Appointment[]
  appointmentItems AppointmentItem[]
  beautyNotes    BeautyClientNote[]
  workerSchedules BeautyWorkerSchedule[]
  timeOffs       BeautyTimeOff[]
  vetMedicalRecords VetMedicalRecord[]
  petVaccinations   PetVaccination[]
  laundryTickets    LaundryTicket[]
  bakeryProductionOrders BakeryProductionOrder[]
  academyCohorts    AcademyCohort[]
  realEstateProperties RealEstateProperty[]
  realEstateLeases  RealEstateLease[]

  @@unique([organizationId, identification])
  @@index([organizationId])
  @@index([branchId])
  @@index([isActive])
}

model ServiceItem {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  category         String?
  estimatedMinutes Int      @default(60)
  basePrice        Decimal  @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  productId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks            ServiceOrderTask[]
  saleServiceItems SaleServiceItem[]
  appointmentItems AppointmentItem[]
  laundryTicketItems LaundryTicketItem[]
  academyCourses   AcademyCourse[]
  serviceOrders  ServiceOrder[]
  product   Product? @relation(fields: [productId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
}

model ServiceOrder {
  id               String             @id @default(cuid())
  organizationId   String
  branchId         String
  orderNumber      String
  customerId       String
  assignedWorkerId String?
  assetName        String
  assetIdentifier  String?
  initialNotes     String?
  diagnosis        String?
  resolutionNotes  String?
  status           ServiceOrderStatus @default(PENDING)
  scheduledAt      DateTime?         // <--- Agregar esta línea
  laborTotal       Decimal            @default(0) @db.Decimal(12, 2)
  materialsTotal   Decimal            @default(0) @db.Decimal(12, 2)
  total            Decimal            @default(0) @db.Decimal(12, 2)
  saleId           String?            @unique
  serviceItemId    String?         // <-- Asegúrate de tener este campo
  vehicleId        String?
  petId            String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer           Customer               @relation(fields: [customerId], references: [id])
  assignedWorker     ServiceWorker?         @relation("ServiceOrderAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  sale               Sale?                  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  serviceItem        ServiceItem?    @relation(fields: [serviceItemId], references: [id])
  vehicle            Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleCheckIn     VehicleCheckIn?
  appointment        Appointment?
  pet                Pet?                   @relation(fields: [petId], references: [id], onDelete: SetNull)
  vetMedicalRecord   VetMedicalRecord?
  laundryTicket      LaundryTicket?
  academyEnrollment  AcademyEnrollment?
  realEstateRentCharge RealEstateRentCharge?
  tasks              ServiceOrderTask[]
  materials          ServiceOrderMaterial[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([assignedWorkerId])
  @@index([vehicleId])
  @@index([petId])
  @@index([status])
  @@index([createdAt])
}

model ServiceOrderTask {
  id               String   @id @default(cuid())
  serviceOrderId   String
  serviceItemId    String?
  description      String
  assignedWorkerId String?
  price            Decimal  @db.Decimal(12, 2)
  isCompleted      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceOrder    ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceItem     ServiceItem?     @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  assignedWorker  ServiceWorker?   @relation("ServiceTaskAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  saleServiceItem SaleServiceItem?

  @@index([serviceOrderId])
  @@index([serviceItemId])
  @@index([assignedWorkerId])
}

model ServiceOrderMaterial {
  id             String   @id @default(cuid())
  serviceOrderId String
  productId      String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCost       Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  isBilled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([serviceOrderId])
  @@index([productId])
}

// Línea de mano de obra para facturación.
// Se mantiene separada de SaleItem porque SaleItem exige productId.
model SaleServiceItem {
  id                 String   @id @default(cuid())
  saleId             String
  serviceItemId      String?
  serviceOrderTaskId String?  @unique
  description        String
  quantity           Int      @default(1)
  unitPrice          Decimal  @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  total              Decimal  @default(0) @db.Decimal(12, 2)
  taxPercentage      Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceItem      ServiceItem?      @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  serviceOrderTask ServiceOrderTask? @relation(fields: [serviceOrderTaskId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([serviceItemId])
  @@index([serviceOrderTaskId])
}

// ============================================================
// USUARIOS Y SEGURIDAD
// ============================================================

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  userRoles     UserRole[]
  goodsReceipts GoodsReceipt[]
  cashSessions  CashSession[]
  internalConsumptions InternalConsumption[]

  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  phoneNumber  String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String @id @default(cuid())
  organizationId String

  firstName            String
  lastName             String?
  companyName          String?
  identificationType   String?
  identificationNumber String?

  email       String?
  phoneNumber String?
  address     String?
  city        String?
  state       String?
  country     String?
  notes       String?
  isActive    Boolean @default(true)

  sales                Sale[]
  saleReturns          SaleReturn[]
  gymSubscriptions     GymSubscription[]
  gymAttendanceLogs    GymAttendanceLog[]
  studioSubscriptions  StudioSubscription[]
  studioAttendanceLogs StudioAttendanceLog[]
  bookings             StudioBooking[]
  serviceOrders        ServiceOrder[]
  hotelReservations     HotelReservation[]
  vehicles             Vehicle[]
  appointments         Appointment[]
  beautyNotes          BeautyClientNote[]
  pets                 Pet[]
  laundryTickets       LaundryTicket[]
  academyEnrollments   AcademyEnrollment[]
  realEstateOwnedProperties RealEstateProperty[] @relation("RealEstatePropertyOwner")
  realEstateTenantLeases    RealEstateLease[]    @relation("RealEstateLeaseTenant")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([identificationNumber])
  @@index([email])
}

// ============================================================
// EXTENSIÓN PARA GIMNASIOS (MEMBRESÍAS Y ACCESOS)
// ============================================================

enum PlanAccessType {
  LIMITED_DAILY // Ej. 1 entrada al día
  UNLIMITED // Entradas ilimitadas
}

model GymMembershipPlan {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String? // Opcional si aplica a toda la organización o por sucursal
  name           String // Ej: "Mensualidad Full", "Pase Diario"
  description    String?
  price          Decimal        @db.Decimal(12, 2)
  durationDays   Int // Vigencia en días
  isActive       Boolean        @default(true)
  accessType     PlanAccessType @default(UNLIMITED) // Nuevo campo
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  subscriptions GymSubscription[]
  productId     String?           @unique
  product       Product?          @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([branchId])
}

model GymSubscription {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String
  customerId       String // Vinculado al cliente/socio del CRM general
  membershipPlanId String
  startDate        DateTime
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  paymentStatus    String   @default("PAID") // PAID, PENDING
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan         GymMembershipPlan @relation(fields: [membershipPlanId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([membershipPlanId])
  @@index([endDate])
}

model GymAttendanceLog {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String
  checkInAt      DateTime @default(now())
  status         String // ALLOWED, DENIED
  reason         String?  @db.VarChar(255)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
}

model GymSchedule {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String // Ej: "Turno Mañana - Musculación", "Turno Tarde"
  dayOfWeek      Int // 0: Domingo, 1: Lunes, ..., 6: Sábado
  startTime      String // Ej: "06:00"
  endTime        String // Ej: "12:00"
  instructorId   String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  instructor       Instructor?          @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  shiftInstructors GymShiftInstructor[]

  @@index([organizationId])
  @@index([branchId])
  @@index([dayOfWeek])
  @@index([instructorId])
}

model GymShiftInstructor {
  id            String   @id @default(cuid())
  gymScheduleId String
  instructorId  String
  shiftDate     DateTime // Fecha del turno (YYYY-MM-DD)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schedule   GymSchedule @relation(fields: [gymScheduleId], references: [id], onDelete: Cascade)
  instructor Instructor  @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@unique([gymScheduleId, shiftDate])
  @@index([instructorId])
  @@index([shiftDate])
}

// ============================================================
// EXTENSIÓN PARA ESTUDIO (YOGA, PILATES, BARRE)
// ============================================================

enum StudioPlanType {
  CLASS_PACK // Paquete por tiquete/crédito de clases (ej. 4 u 8 clases)
  UNLIMITED // Plan ilimitado por días (ej. 1 mes o 3 meses)
}

enum InstructorPaymentModel {
  FIXED_PER_CLASS
  PER_STUDENT
  HYBRID
}

model Instructor {
  id             String                 @id @default(cuid())
  organizationId String
  branchId       String?
  firstName      String
  lastName       String?
  identification String
  phoneNumber    String?
  email          String?
  specialty      String?
  businessType   String                 @default("STUDIO")
  paymentModel   InstructorPaymentModel @default(FIXED_PER_CLASS)
  fixedClassRate Decimal                @default(0) @db.Decimal(12, 2)
  perStudentRate Decimal                @default(0) @db.Decimal(12, 2)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules           StudioSchedule[]
  classInstructors    StudioClassInstructor[]
  gymSchedules        GymSchedule[]
  gymShiftInstructors GymShiftInstructor[]

  @@unique([organizationId, identification])
  @@index([organizationId])
  @@index([branchId])
  @@index([businessType])
}

model StudioPlan {
  id               String         @id @default(cuid())
  organizationId   String
  branchId         String?
  name             String // Ej: "Paquete presencial de 4 clases", "Plan trimestral ilimitado"
  description      String?
  price            Decimal        @db.Decimal(12, 2)
  durationDays     Int // Vigencia en días (30, 90, etc.)
  type             StudioPlanType @default(CLASS_PACK)
  totalClasses     Int? // Número de clases compradas (null si es UNLIMITED)
  maxDailyCheckIns Int?           @default(2) // Límite diario (ej. máximo 2 veces al día)
  isNewStudentOnly Boolean        @default(false) // Para paquete de bienvenida alumnos nuevos
  badge            String? // Ej: "Mejor precio/calidad"
  isActive         Boolean        @default(true)

  // Enlace con el catálogo de productos POS
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id])

  subscriptions StudioSubscription[]
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([branchId])
}

model StudioSubscription {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String
  customerId       String
  studioPlanId     String
  startDate        DateTime
  endDate          DateTime
  totalClasses     Int? // Clases iniciales asignadas
  remainingClasses Int? // Clases disponibles restates
  status           String   @default("ACTIVE") // ACTIVE, EXPIRED, EXHAUSTED, CANCELLED

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan           StudioPlan            @relation(fields: [studioPlanId], references: [id])
  attendanceLogs StudioAttendanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([studioPlanId])
}

model StudioAttendanceLog {
  id                   String   @id @default(cuid())
  organizationId       String
  branchId             String
  customerId           String
  studioSubscriptionId String? // <--- Agregar '?' para permitir valores nulos
  studioScheduleId     String? // <-- AGREGAR ESTE CAMPO (Opcional)
  checkInAt            DateTime @default(now())
  status               String // ALLOWED, DENIED
  reason               String?  @db.VarChar(255)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription StudioSubscription? @relation(fields: [studioSubscriptionId], references: [id], onDelete: SetNull)
  schedule     StudioSchedule?     @relation(fields: [studioScheduleId], references: [id], onDelete: SetNull) // <-- AGREGAR RELACIÓN

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([studioSubscriptionId])
  @@index([studioScheduleId])
}

model StudioSchedule {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  className      String
  instructorName String?
  instructorId   String?
  dayOfWeek      Int // 0: Domingo, 1: Lunes, ..., 6: Sábado
  startTime      String // Ej: "09:00"
  endTime        String // Ej: "10:00"
  capacity       Int      @default(15)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  instructor   Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  attendanceLogs   StudioAttendanceLog[]
  bookings         StudioBooking[]
  classInstructors StudioClassInstructor[]

  @@index([organizationId])
  @@index([branchId])
  @@index([dayOfWeek])
  @@index([instructorId])
}

model StudioClassInstructor {
  id               String   @id @default(cuid())
  studioScheduleId String
  instructorId     String
  classDate        DateTime
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schedule   StudioSchedule @relation(fields: [studioScheduleId], references: [id], onDelete: Cascade)
  instructor Instructor     @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@unique([studioScheduleId, classDate])
  @@index([instructorId])
  @@index([classDate])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
}

model StudioBooking {
  id               String        @id @default(uuid())
  organizationId   String
  branchId         String
  customerId       String
  studioScheduleId String
  bookingDate      DateTime // Fecha de la clase reservada (YYYY-MM-DD)
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  schedule StudioSchedule @relation(fields: [studioScheduleId], references: [id])

  @@unique([studioScheduleId, customerId, bookingDate])
}

// --- ENUMS ---
enum HotelRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

// --- MODELS ---
model HotelRoom {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String
  roomNumber     String
  roomType       String          // Ej. SINGLE, DOUBLE, SUITE
  description    String?
  capacity       Int             @default(2)
  pricePerNight  Decimal?        @db.Decimal(10, 2)
  status         HotelRoomStatus @default(AVAILABLE)

  hotelReservations   HotelReservation[]

  // Relaciones (Asegúrate de tener los campos correctos hacia tus modelos globales)
  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, branchId, roomNumber]) // Evita números de habitación duplicados en la misma sucursal
}

model HotelReservation {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String
  hotelRoomId    String

  checkInDate    DateTime
  checkOutDate   DateTime
  nightlyRate    Decimal?          @db.Decimal(12, 2)
  totalAmount    Decimal?          @db.Decimal(12, 2)
  notes          String?
  status         ReservationStatus @default(CONFIRMED)

  // Operaciones avanzadas
  cancellationReason  String?
  cancellationCharge  Decimal?  @db.Decimal(12, 2)
  actualCheckInAt     DateTime?
  actualCheckOutAt    DateTime?

  hotelRoom      HotelRoom         @relation(fields: [hotelRoomId], references: [id])

  saleId         String?           @unique
  sale           Sale?             @relation(fields: [saleId], references: [id])

  charges        HotelRoomCharge[]

  // Relaciones
  customer     Customer          @relation(fields: [customerId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model HotelRoomCharge {
  id             String           @id @default(cuid())
  organizationId String
  reservationId  String
  description    String
  amount         Decimal          @db.Decimal(12, 2)
  quantity       Int              @default(1)
  productId      String?
  createdAt      DateTime         @default(now())

  reservation    HotelReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product        Product?         @relation(fields: [productId], references: [id])

  @@index([reservationId])
  @@index([organizationId])
}

model InternalConsumption {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  userId         String              // Usuario que registra la salida
  code           String              // Folio ej: CONS-2026-0001
  department     String?             // Ej: "Housekeeping", "Spa", "Mantenimiento"
  notes          String?
  createdAt      DateTime            @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id])
  branch              Branch              @relation(fields: [branchId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  inventoryMovements  InventoryMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
}

// ============================================================
// ARQUITECTURA DE VERTICALES DE NEGOCIO (MULTI-VERTICAL TENANT)
// ============================================================

model Vertical {
  id          String   @id @default(cuid())
  code        String   @unique // RETAIL, AUTOMOTIVE, BEAUTY, RESTAURANT, HOTEL, etc.
  name        String   // "Retail / Comercio", "Taller Automotriz", etc.
  description String?
  icon        String?  // Nombre del ícono o emoji
  isCore      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationVerticals OrganizationVertical[]

  @@index([code])
}

model OrganizationVertical {
  id             String   @id @default(cuid())
  organizationId String
  verticalId     String
  isActive       Boolean  @default(true)
  activatedAt    DateTime @default(now())
  config         Json?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical       Vertical     @relation(fields: [verticalId], references: [id], onDelete: Cascade)

  @@unique([organizationId, verticalId])
  @@index([organizationId])
  @@index([verticalId])
}

// ============================================================
// VERTICAL AUTOMOTIVE / TALLER MECÁNICO
// ============================================================

model Vehicle {
  id             String      @id @default(cuid())
  organizationId String
  customerId     String
  licensePlate   String      // Placa o patente (ej: "ABC-123")
  brand          String      // Ej: "Toyota", "Chevrolet", "Yamaha"
  model          String      // Ej: "Corolla", "Spark GT", "MT-03"
  year           Int?        // Año modelo ej: 2022
  color          String?     // Ej: "Gris Plata"
  vin            String?     // Número de chasis / VIN
  mileage        Int?        // Kilometraje actual o último registrado
  vehicleType    VehicleType @default(CAR)
  fuelType       String?     // Gasolina, Diésel, Gas, Híbrido, Eléctrico
  notes          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrders  ServiceOrder[]
  checkIns       VehicleCheckIn[]

  @@unique([organizationId, licensePlate])
  @@index([organizationId])
  @@index([customerId])
  @@index([licensePlate])
}

model VehicleCheckIn {
  id                 String    @id @default(cuid())
  organizationId     String
  branchId           String
  vehicleId          String
  serviceOrderId     String?   @unique
  mileage            Int       // Kilometraje al momento del ingreso
  fuelLevel          FuelLevel @default(HALF)
  damages            Json?     // Registro de abolladuras, rayones, etc.
  inventoryCheck     Json?     // Checklist de pertenencias (gato, llanta repuesto, documentos, etc.)
  customerBelongings String?   // Objetos de valor declarados
  receptionNotes     String?   // Notas de recepción
  receivedById       String?   // Técnico o usuario que recepcionó
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([vehicleId])
}


// ============================================================
// VERTICAL BEAUTY / SALON / BARBERIA / SPA
// Reutiliza: Customer, ServiceWorker (estilistas), ServiceItem (catalogo),
// ServiceOrder (ejecucion, comisiones y cobro POS).
// ============================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  branchId          String
  customerId        String
  workerId          String?
  serviceOrderId    String?           @unique
  appointmentNumber String
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(SCHEDULED)
  totalEstimated    Decimal           @default(0) @db.Decimal(12, 2)
  notes             String?
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker       ServiceWorker?    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder?     @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  items        AppointmentItem[]

  @@unique([organizationId, appointmentNumber])
  @@index([organizationId])
  @@index([branchId, startAt])
  @@index([workerId, startAt])
  @@index([customerId])
  @@index([status])
}

model AppointmentItem {
  id              String   @id @default(cuid())
  organizationId  String
  appointmentId   String
  serviceItemId   String
  workerId        String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(30)
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceItem  ServiceItem    @relation(fields: [serviceItemId], references: [id])
  worker       ServiceWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([appointmentId])
}

model BeautyWorkerSchedule {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  workerId       String
  dayOfWeek      Int // 0 = domingo ... 6 = sabado
  startTime      String // "09:00"
  endTime        String // "18:00"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  worker       ServiceWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, branchId, dayOfWeek])
  @@index([organizationId])
  @@index([branchId])
}

model BeautyTimeOff {
  id             String   @id @default(cuid())
  organizationId String
  workerId       String
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       ServiceWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workerId, startAt])
}

model BeautyClientNote {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  workerId       String?
  title          String
  content        String // Formula de color, preferencias, alergias, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker       ServiceWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
}

// ==========================================
// FASE 4: VERTICAL VETERINARY (VETERINARIA & PET SHOP)
// ==========================================

enum PetSpecies {
  CANINE
  FELINE
  AVIAN
  RODENT
  REPTILE
  EQUINE
  BOVINE
  OTHER
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum VetVisitType {
  CONSULTATION
  EMERGENCY
  VACCINATION
  DEWORMING
  SURGERY
  GROOMING
  CHECKUP
  HOSPITALIZATION
}

model Pet {
  id              String     @id @default(cuid())
  organizationId  String
  customerId      String
  name            String
  species         PetSpecies @default(CANINE)
  breed           String?
  gender          PetGender  @default(UNKNOWN)
  birthDate       DateTime?
  color           String?
  weightKg        Decimal?   @db.Decimal(6, 2)
  microchipNumber String?
  isSterilized    Boolean    @default(false)
  allergies       String?
  chronicIssues   String?
  notes           String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  medicalRecords VetMedicalRecord[]
  vaccinations   PetVaccination[]
  serviceOrders  ServiceOrder[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, name])
  @@index([organizationId, microchipNumber])
}

model VetMedicalRecord {
  id               String       @id @default(cuid())
  organizationId   String
  branchId         String
  petId            String
  veterinarianId   String?
  serviceOrderId   String?      @unique
  visitType        VetVisitType @default(CONSULTATION)
  visitDate        DateTime     @default(now())
  weightKg         Decimal?     @db.Decimal(6, 2)
  temperatureC     Decimal?     @db.Decimal(4, 1)
  heartRateBpm     Int?
  respiratoryRate  Int?
  reason           String
  anamnesis        String?
  physicalExam     String?
  diagnosis        String?
  treatment        String?
  prescription     String?
  nextControlDate  DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  pet          Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  veterinarian ServiceWorker? @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder?  @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([petId, visitDate])
  @@index([veterinarianId])
}

model PetVaccination {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String
  petId          String
  veterinarianId String?
  productId      String?
  vaccineName    String
  type           String    @default("VACCINE") // VACCINE, DEWORMING, ANTIPARASITIC
  batchNumber    String?
  dose           String?
  appliedAt      DateTime  @default(now())
  nextDueDate    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  pet          Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  veterinarian ServiceWorker? @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  product      Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([petId, appliedAt])
  @@index([organizationId, nextDueDate])
}

// ==========================================
// FASE 5: VERTICAL LAUNDRY (LAVANDERÍA & TINTORERÍA)
// ==========================================

enum LaundryTicketStatus {
  RECEIVED
  WASHING
  DRYING
  IRONING
  READY
  DELIVERED
  CANCELLED
}

enum LaundryPricingMode {
  BY_WEIGHT
  BY_GARMENT
  MIXED
}

model LaundryTicket {
  id               String              @id @default(cuid())
  organizationId   String
  branchId         String
  customerId       String
  workerId         String?
  serviceOrderId   String?             @unique
  ticketNumber     String
  status           LaundryTicketStatus @default(RECEIVED)
  pricingMode      LaundryPricingMode  @default(MIXED)
  totalWeightKg    Decimal?            @db.Decimal(8, 2)
  pricePerKg       Decimal?            @db.Decimal(12, 2)
  totalPieces      Int                 @default(0)
  rackLocation     String? // Ej: "Perchero B-04" o "Estante 12"
  isExpress        Boolean             @default(false)
  promisedAt       DateTime?
  deliveredAt      DateTime?
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  expressSurcharge Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  worker       ServiceWorker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder?       @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  items        LaundryTicketItem[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, branchId, status])
  @@index([customerId])
  @@index([workerId])
}

model LaundryTicketItem {
  id            String   @id @default(cuid())
  ticketId      String
  serviceItemId String?
  garmentType   String // Ej: "Camisa", "Pantalón", "Edredón Queen", "Ropa de color por kg"
  processType   String   @default("WASH_AND_FOLD") // WASH_AND_FOLD, DRY_CLEAN, IRON_ONLY, STAIN_REMOVAL, DYEING
  color         String?
  brand         String?
  defectsNotes  String? // Manchas previas, roturas, botones faltantes
  quantity      Int      @default(1)
  weightKg      Decimal? @db.Decimal(8, 2)
  unitPrice     Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  ticket      LaundryTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?  @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([serviceItemId])
}

// ==========================================
// FASE 6: VERTICAL BAKERY (PANADERÍA & PASTELERÍA)
// ==========================================

enum BakeryProductionStatus {
  PLANNED
  MIXING
  FERMENTING
  BAKING
  COOLING_DECORATING
  COMPLETED
  CANCELLED
}

model BakeryRecipe {
  id                  String   @id @default(cuid())
  organizationId      String
  finishedProductId   String
  name                String // Ej: "Tanda Pan Francés Artesanal x 50 und"
  code                String?
  yieldQuantity       Decimal  @db.Decimal(12, 3) // Rendimiento esperado por tanda
  yieldUnit           String   @default("UND") // UND, KG, LB, BANDEJA
  prepMinutes         Int      @default(45)
  bakeMinutes         Int      @default(25)
  ovenTempC           Int? // Temperatura de horneado (°C)
  shelfLifeDays       Int      @default(3) // Días de frescura para crear ProductLot automático
  estimatedBatchCost  Decimal  @default(0) @db.Decimal(12, 2)
  estimatedUnitCost   Decimal  @default(0) @db.Decimal(12, 2)
  instructions        String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finishedProduct  Product                  @relation("BakeryFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)
  ingredients      BakeryRecipeIngredient[]
  productionOrders BakeryProductionOrder[]

  @@index([organizationId])
  @@index([finishedProductId])
}

model BakeryRecipeIngredient {
  id                  String   @id @default(cuid())
  recipeId            String
  ingredientProductId String
  quantity            Decimal  @db.Decimal(12, 3) // Cantidad requerida por 1 tanda base
  unit                String   @default("KG") // KG, GR, LT, ML, UND
  notes               String?
  createdAt           DateTime @default(now())

  recipe            BakeryRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProduct Product      @relation("BakeryIngredientProduct", fields: [ingredientProductId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientProductId])
}

model BakeryProductionOrder {
  id                   String                 @id @default(cuid())
  organizationId       String
  branchId             String
  recipeId             String
  finishedProductId    String
  bakerWorkerId        String?
  batchNumber          String // Ej: "HOR-482910"
  status               BakeryProductionStatus @default(PLANNED)
  batchesMultiplier    Decimal                @default(1) @db.Decimal(8, 2) // Ej: 1 tanda, 2 tandas
  plannedQuantity      Decimal                @db.Decimal(12, 3)
  actualQuantity       Decimal?               @db.Decimal(12, 3)
  wasteQuantity        Decimal                @default(0) @db.Decimal(12, 3)
  wasteReason          String?
  totalIngredientsCost Decimal                @default(0) @db.Decimal(12, 2)
  unitProductionCost   Decimal                @default(0) @db.Decimal(12, 2)
  ovenNumber           String? // Ej: "Horno Rotativo #1"
  scheduledAt          DateTime               @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recipe          BakeryRecipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  finishedProduct Product        @relation("BakeryProductionFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)
  bakerWorker     ServiceWorker? @relation(fields: [bakerWorkerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, batchNumber])
  @@index([organizationId, branchId, status])
  @@index([recipeId])
  @@index([finishedProductId])
}

// ==========================================
// FASE 7: VERTICAL ACADEMY (ACADEMIA / CENTRO EDUCATIVO)
// ==========================================

enum AcademyEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  DROPPED
}

enum AcademyAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model AcademyCourse {
  id             String   @id @default(cuid())
  organizationId String
  code           String // Ej: "CUR-ING-B1", "CUR-PIA-01"
  name           String // Ej: "Inglés Conversacional B1", "Piano Básico"
  category       String   @default("IDIOMAS") // IDIOMAS, MUSICA_ARTES, TECNOLOGIA, TUTORIA_ESCOLAR, DEPORTES, OTRO
  level          String   @default("BASICO") // INICIAL, BASICO, INTERMEDIO, AVANZADO, CERTIFICACION
  durationWeeks  Int      @default(12)
  totalHours     Int      @default(48)
  tuitionFee     Decimal  @default(0) @db.Decimal(12, 2) // Valor inscripción/matrícula
  monthlyFee     Decimal  @default(0) @db.Decimal(12, 2) // Valor pensión/mensualidad o módulo
  serviceItemId  String? // Vínculo opcional con ServiceItem para cobro y comisiones
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceItem  ServiceItem?    @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  cohorts      AcademyCohort[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AcademyCohort {
  id              String    @id @default(cuid())
  organizationId  String
  branchId        String
  courseId        String
  teacherWorkerId String?
  code            String // Ej: "GRP-2026-01"
  name            String // Ej: "Grupo Sabatino Mañana - Aula 102"
  classroom       String? // Ej: "Aula 102 / Virtual Zoom"
  scheduleLabel   String // Ej: "Lun-Mié-Vie 6:00 PM - 8:00 PM"
  startDate       DateTime
  endDate         DateTime?
  maxCapacity     Int       @default(20)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  course        AcademyCourse       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacherWorker ServiceWorker?      @relation(fields: [teacherWorkerId], references: [id], onDelete: SetNull)
  enrollments   AcademyEnrollment[]
  attendances   AcademyAttendance[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@index([courseId])
  @@index([teacherWorkerId])
}

model AcademyEnrollment {
  id                String                  @id @default(cuid())
  organizationId    String
  branchId          String
  cohortId          String
  studentCustomerId String
  serviceOrderId    String?                 @unique
  enrollmentNumber  String // Ej: "MAT-839201"
  status            AcademyEnrollmentStatus @default(ACTIVE)
  scholarshipPct    Decimal                 @default(0) @db.Decimal(5, 2)
  agreedTotalAmount Decimal                 @db.Decimal(12, 2)
  finalGrade        Decimal?                @db.Decimal(5, 2)
  attendancePct     Decimal                 @default(100) @db.Decimal(5, 2)
  guardianName      String?
  guardianPhone     String?
  notes             String?
  enrolledAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cohort          AcademyCohort       @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  studentCustomer Customer            @relation(fields: [studentCustomerId], references: [id], onDelete: Restrict)
  serviceOrder    ServiceOrder?       @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  attendances     AcademyAttendance[]

  @@unique([organizationId, enrollmentNumber])
  @@index([organizationId, branchId])
  @@index([cohortId])
  @@index([studentCustomerId])
}

model AcademyAttendance {
  id             String                  @id @default(cuid())
  organizationId String
  cohortId       String
  enrollmentId   String
  sessionDate    DateTime                @default(now())
  topic          String?
  status         AcademyAttendanceStatus @default(PRESENT)
  gradeScore     Decimal?                @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime                @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort       AcademyCohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  enrollment   AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, cohortId, sessionDate])
  @@index([enrollmentId])
}

// ==========================================
// FASE 8: VERTICAL REAL_ESTATE (INMOBILIARIA & PROPIEDADES)
// ==========================================

enum RealEstatePropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL_LOCAL
  OFFICE
  WAREHOUSE
  LAND
}

enum RealEstatePropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  SOLD
}

enum RealEstateLeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING_SIGNATURE
}

model RealEstateProperty {
  id                  String                   @id @default(cuid())
  organizationId      String
  branchId            String
  ownerCustomerId     String
  agentWorkerId       String?
  code                String // Ej: "INM-4012"
  title               String // Ej: "Apto 802 Mirador del Parque"
  propertyType        RealEstatePropertyType   @default(APARTMENT)
  status              RealEstatePropertyStatus @default(AVAILABLE)
  address             String
  city                String                   @default("Medellín")
  neighborhood        String?
  areaM2              Decimal?                 @db.Decimal(10, 2)
  bedrooms            Int                      @default(0)
  bathrooms           Int                      @default(0)
  parkingSpots        Int                      @default(0)
  monthlyRentPrice    Decimal                  @db.Decimal(12, 2)
  adminFeePrice       Decimal                  @default(0) @db.Decimal(12, 2)
  salePrice           Decimal?                 @db.Decimal(14, 2)
  agencyCommissionPct Decimal                  @default(10) @db.Decimal(5, 2)
  notes               String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ownerCustomer Customer          @relation("RealEstatePropertyOwner", fields: [ownerCustomerId], references: [id], onDelete: Restrict)
  agentWorker   ServiceWorker?    @relation(fields: [agentWorkerId], references: [id], onDelete: SetNull)
  leases        RealEstateLease[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, status])
  @@index([ownerCustomerId])
}

model RealEstateLease {
  id                  String                @id @default(cuid())
  organizationId      String
  branchId            String
  propertyId          String
  tenantCustomerId    String
  agentWorkerId       String?
  contractNumber      String // Ej: "ARR-2026-0041"
  status              RealEstateLeaseStatus @default(ACTIVE)
  startDate           DateTime
  endDate             DateTime
  paymentDay          Int                   @default(5) // Día límite de pago de cada mes
  monthlyRent         Decimal               @db.Decimal(12, 2)
  adminFee            Decimal               @default(0) @db.Decimal(12, 2)
  securityDeposit     Decimal               @default(0) @db.Decimal(12, 2)
  agencyCommissionPct Decimal               @default(10) @db.Decimal(5, 2)
  coSignerName        String?
  coSignerPhone       String?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  property       RealEstateProperty     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenantCustomer Customer               @relation("RealEstateLeaseTenant", fields: [tenantCustomerId], references: [id], onDelete: Restrict)
  agentWorker    ServiceWorker?         @relation(fields: [agentWorkerId], references: [id], onDelete: SetNull)
  rentCharges    RealEstateRentCharge[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId, branchId, status])
  @@index([propertyId])
  @@index([tenantCustomerId])
}

model RealEstateRentCharge {
  id                     String   @id @default(cuid())
  organizationId         String
  branchId               String
  leaseId                String
  serviceOrderId         String?  @unique
  periodLabel            String // Ej: "2026-10"
  dueDate                DateTime
  rentAmount             Decimal  @db.Decimal(12, 2)
  adminFeeAmount         Decimal  @default(0) @db.Decimal(12, 2)
  lateFeeAmount          Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal  @db.Decimal(12, 2)
  agencyCommissionAmount Decimal  @default(0) @db.Decimal(12, 2)
  ownerNetAmount         Decimal  @default(0) @db.Decimal(12, 2)
  isOwnerDisbursed       Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lease        RealEstateLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@unique([leaseId, periodLabel])
  @@index([organizationId, branchId])
  @@index([leaseId])
}