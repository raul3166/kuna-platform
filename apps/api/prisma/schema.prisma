generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  CUSTOMER_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH            // Efectivo
  CREDIT_CARD     // Tarjeta de Crédito
  DEBIT_CARD      // Tarjeta de Débito
  TRANSFER        // Transferencia bancaria (Ej: Nequi, Daviplata, Pix)
  CREDIT          // Crédito comercial / Cuenta por cobrar
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_PRINTED
  RESERVED
}

enum KitchenStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum TaxType {
  VAT          // IVA
  CONSUMPTION  // INC (Impuesto Nacional al Consumo)
  WITHHOLDING  // Retenciones (ReteFuente, ReteIVA, ReteICA)
}

enum GoodsReceiptStatus {
  DRAFT
  PROCESSED
  CANCELLED
}

// ============================================================
// ESTRUCTURA IMPUESTOS
// ============================================================

model TaxRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String       // Ej: "IVA General 19%", "INC 8%", "ReteFuente Compras 2.5%"
  code           String       // Ej: "IVA_19", "INC_8", "RET_25"
  type           TaxType
  percentage     Decimal      @db.Decimal(5, 2)
  isRetention    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])

}

// ============================================================
// ESTRUCTURA ORGANIZACIONAL
// ============================================================

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  country            String
  timezone           String              @default("America/Bogota")
  isActive           Boolean             @default(true)
  branches           Branch[]
  users              User[]
  roles              Role[]
  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  productCategories  ProductCategory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  inventoryTransfers InventoryTransfer[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  payments           Payment[]
  billingResolutions BillingResolution[]
  cashSessions       CashSession[]
  rooms              Room[]
  taxes              TaxRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Branch {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])

  name                 String
  code                 String
  address              String
  city                 String
  country              String
  phoneNumber          String?
  timezone             String

  users                User[]
  productStocks        BranchProductStock[]

  sourceTransfers      InventoryTransfer[]  @relation("TransferSourceBranch")
  destinationTransfers InventoryTransfer[]  @relation("TransferDestinationBranch")

  inventoryMovements   InventoryMovement[]
  sales                Sale[]
  saleReturns          SaleReturn[]
  billingResolutions   BillingResolution[]
  cashSessions         CashSession[]
  rooms                Room[]
  purchaseOrders PurchaseOrder[]
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([organizationId, code])
}
// ============================================================
// PROVEEDORES Y PRODUCTOS
// ============================================================

model Supplier {
  id                   String            @id @default(cuid())
  organizationId       String

  companyName          String
  contactName          String?
  identificationType   String
  identificationNumber String
  email                String?
  phoneNumber          String?
  address              String?
  city                 String?
  state                String?
  country              String?
  notes                String?

  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  products             Product[]
  purchaseOrders       PurchaseOrder[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  organization         Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, identificationNumber])
}

model Product {
  id                   String                 @id @default(cuid())
  organizationId       String

  sku                  String
  name                 String
  description          String?
  barcode              String?

  salePrice            Decimal                @db.Decimal(12, 2)
  costPrice            Decimal                @db.Decimal(12, 2)
  stock                Decimal                @default(0) @db.Decimal(12, 3)

  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  categoryId           String?
  supplierId           String?
  taxRuleId String?

  inventoryMovements   InventoryMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  branchStocks         BranchProductStock[]
  inventoryTransfers   InventoryTransfer[]
  items                SaleItem[]
  returnItems          SaleReturnItem[]
  restaurantOrderItems RestaurantOrderItem[]  // <--- NUEVA RELACIÓN
  category             ProductCategory?       @relation(fields: [categoryId], references: [id])
  supplier             Supplier?              @relation(fields: [supplierId], references: [id])

  organization         Organization           @relation(fields: [organizationId], references: [id])
  taxRule              TaxRule? @relation(fields: [taxRuleId], references: [id])
  @@unique([organizationId, sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([taxRuleId])
}

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

// ============================================================
// INVENTARIOS Y COMPRAS
// ============================================================

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  productId      String
  branchId       String?
  movementType   InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  unitCost       Decimal?              @db.Decimal(12, 2)
  totalCost      Decimal?              @db.Decimal(14, 2)
  reference      String?
  notes          String?
  createdAt      DateTime              @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id])
  product        Product               @relation(fields: [productId], references: [id])
  branch         Branch?               @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([branchId])
}

model PurchaseOrder {
  id             String             @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime
  expectedDate   DateTime?
  notes          String?
  subtotal       Decimal            @default(0) @db.Decimal(12, 2)
  tax            Decimal            @default(0) @db.Decimal(12, 2)
  total          Decimal            @default(0) @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns PurchaseReturn[]

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String      @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal     @db.Decimal(18, 4)
  unitCost        Decimal     @db.Decimal(18, 4)
  subtotal        Decimal     @db.Decimal(18, 4)
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  goodsReceiptItems GoodsReceiptItem[]
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  number          String
  receivedDate    DateTime
  receivedById    String?
  status          GoodsReceiptStatus @default(DRAFT)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id])
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy       User?              @relation(fields: [receivedById], references: [id])

  items            GoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([receivedById])
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityReceived    Decimal  @db.Decimal(18, 4)
  notes               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseReturnItems PurchaseReturnItem[]
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([productId])
}

model PurchaseInvoice {
  id              String                @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String?
  goodsReceiptId  String?
  number          String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          PurchaseInvoiceStatus @default(DRAFT)

  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  tax             Decimal               @default(0) @db.Decimal(12, 2)
  total           Decimal               @default(0) @db.Decimal(12, 2)
  notes           String?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id])
  items         PurchaseInvoiceItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  productId         String
  quantity          Decimal         @db.Decimal(18, 4)
  unitCost          Decimal         @db.Decimal(18, 4)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  subtotal          Decimal         @db.Decimal(18, 4)
  total             Decimal         @db.Decimal(18, 4)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model PurchaseReturn {
  id              String               @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String
  goodsReceiptId  String?
  number          String
  returnDate      DateTime
  status          PurchaseReturnStatus @default(DRAFT)
  reason          String?
  notes           String?

  subtotal        Decimal              @default(0) @db.Decimal(12, 2)
  tax             Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @default(0) @db.Decimal(12, 2)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id])
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt   GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id])
  items          PurchaseReturnItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseReturnItem {
  id                 String           @id @default(cuid())
  purchaseReturnId   String
  goodsReceiptItemId String
  productId          String
  quantity           Decimal          @db.Decimal(18, 4)
  unitCost           Decimal          @db.Decimal(18, 4)
  subtotal           Decimal          @db.Decimal(18, 4)
  notes              String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  purchaseReturn   PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id])
  goodsReceiptItem GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@index([goodsReceiptItemId])
  @@index([productId])
}

model BranchProductStock {
  id          String   @id @default(cuid())
  branchId    String
  productId   String
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  averageCost Decimal  @default(0) @db.Decimal(12, 2)

  branch      Branch   @relation(fields: [branchId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model InventoryTransfer {
  id                  String       @id @default(cuid())
  organizationId      String
  productId           String
  sourceBranchId      String
  destinationBranchId String
  quantity            Decimal      @db.Decimal(12, 3)
  reference           String
  notes               String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])
  sourceBranch      Branch       @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id])
  destinationBranch Branch       @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([productId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
}

// ============================================================
// MÓDULO RESTAURANTE (AMBIENTES, MESAS Y COMANDAS)
// ============================================================

model Room {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tables         RestaurantTable[]
  organization   Organization      @relation(fields: [organizationId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([branchId])
}

model RestaurantTable {
  id             String            @id @default(cuid())
  roomId         String
  tableNumber    String
  capacity       Int
  status         TableStatus       @default(AVAILABLE)
  currentOrderId String?           // Vincula la comanda/orden activa de cocina
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  room           Room              @relation(fields: [roomId], references: [id])
  currentOrder   RestaurantOrder?  @relation("ActiveTableOrder", fields: [currentOrderId], references: [id])
  orders         RestaurantOrder[] @relation("TableOrderHistory")
  sales          Sale[]            @relation("TableSales")

  @@index([roomId])
  @@index([currentOrderId])
}

model RestaurantOrder {
  id            String                @id @default(cuid())
  organizationId String
  branchId       String
  tableId       String
  status        KitchenStatus         @default(PENDING)
  notes         String?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Vinculación opcional con la venta al momento de cobrar la mesa
  saleId        String?               @unique
  sale          Sale?                 @relation(fields: [saleId], references: [id])

  table         RestaurantTable       @relation("TableOrderHistory", fields: [tableId], references: [id])
  activeOnTable RestaurantTable[]     @relation("ActiveTableOrder")
  items         RestaurantOrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
}

model RestaurantOrderItem {
  id                String          @id @default(cuid())
  restaurantOrderId String
  restaurantOrder   RestaurantOrder @relation(fields: [restaurantOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12, 2)
  notes             String?         @db.VarChar(255)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([restaurantOrderId])
  @@index([productId])
}

// ============================================================
// VENTAS Y FACTURACIÓN (NÚCLEO FINANCIERO GENÉRICO)
// ============================================================

model Sale {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String?
  tableId        String?          // Opcional para guardar referencia histórica de la mesa
  orderId        String?          @unique
  saleNumber     String
  status         SaleStatus       @default(DRAFT)

  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  tax            Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)

  notes          String?
  items          SaleItem[]
  saleReturns    SaleReturn[]
  payments       Payment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  table           RestaurantTable? @relation("TableSales", fields: [tableId], references: [id])
  restaurantOrder RestaurantOrder? // Relación inversa opcional con la orden de cocina

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([tableId])
  @@index([status])
}

model SaleItem {
  id          String           @id @default(cuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Decimal          @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  total       Decimal          @default(0) @db.Decimal(12, 2)
  description String?          @db.VarChar(255)
  taxPercentage Decimal        @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items       SaleReturnItem[]
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String
  saleId         String
  customerId     String?

  returnNumber   String
  status         SaleReturnStatus @default(DRAFT)
  returnDate     DateTime

  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)

  reason         String?          @db.VarChar(255)
  notes          String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  sale           Sale             @relation(fields: [saleId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  items          SaleReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([saleId])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleItemId   String
  productId    String
  quantity     Int
  unitCost     Decimal    @db.Decimal(12, 2)
  notes        String?    @db.VarChar(255)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String

  method         PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?       @db.VarChar(100)
  paymentDate    DateTime      @default(now())
  notes          String?       @db.VarChar(255)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([saleId])
}

model BillingResolution {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String   @unique

  prefix           String   @db.VarChar(15)
  resolutionNumber String   @db.VarChar(50)
  fromNumber       Int
  toNumber         Int
  currentNumber    Int
  expiryDate       DateTime

  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  branch           Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId])
}

model CashSession {
  id              String            @id @default(cuid())
  organizationId  String
  branchId        String
  userId          String

  status          CashSessionStatus @default(OPEN)
  openingDate     DateTime          @default(now())
  closingDate     DateTime?

  openingBalance  Decimal           @db.Decimal(12, 2)
  expectedBalance Decimal           @default(0) @db.Decimal(12, 2)
  actualBalance   Decimal?          @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)

  notes           String?           @db.VarChar(255)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  branch          Branch            @relation(fields: [branchId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
}

// ============================================================
// USUARIOS Y SEGURIDAD
// ============================================================

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean          @default(true)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])

  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  userRoles      UserRole[]
  goodsReceipts  GoodsReceipt[]
  cashSessions   CashSession[]

  firstName      String
  lastName       String
  email          String         @unique
  passwordHash   String
  phoneNumber    String?
  isActive       Boolean        @default(true)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Customer {
  id                   String       @id @default(cuid())
  organizationId       String

  firstName            String
  lastName             String?
  companyName          String?
  identificationType   String?
  identificationNumber String?

  email                String?
  phoneNumber          String?
  address              String?
  city                 String?
  state                String?
  country              String?
  notes                String?
  isActive             Boolean      @default(true)

  sales                Sale[]
  saleReturns          SaleReturn[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([identificationNumber])
  @@index([email])
}
