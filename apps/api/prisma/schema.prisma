generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  CUSTOMER_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleReturnStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH            // Efectivo
  CREDIT_CARD     // Tarjeta de Crédito
  DEBIT_CARD      // Tarjeta de Débito
  TRANSFER        // Transferencia bancaria (Ej: Nequi, Daviplata, Pix)
  CREDIT          // Crédito comercial / Cuenta por cobrar
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  country            String
  timezone           String              @default("America/Bogota")
  isActive           Boolean             @default(true)
  branches           Branch[]
  users              User[]
  roles              Role[]
  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  productCategories  ProductCategory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  inventoryTransfers InventoryTransfer[]
  sales Sale[]
  saleReturns SaleReturn[]
  payments Payment[]
  billingResolutions BillingResolution[]
  cashSessions CashSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Branch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  code String

  address String
  city    String
  country String

  phoneNumber String?
  timezone    String

  users User[]

  productStocks BranchProductStock[]

  sourceTransfers      InventoryTransfer[] @relation("TransferSourceBranch")
  destinationTransfers InventoryTransfer[] @relation("TransferDestinationBranch")

  inventoryMovements InventoryMovement[]
  sales Sale[]
  saleReturns SaleReturn[]
  billingResolutions BillingResolution[]
  cashSessions CashSession[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
}

model Supplier {
  id String @id @default(cuid())

  organizationId String

  companyName String

  contactName String?

  identificationType String

  identificationNumber String

  email String?

  phoneNumber String?

  address String?

  city String?

  state String?

  country String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  organization     Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, identificationNumber])
}

model Product {
  id String @id @default(cuid())

  organizationId String

  sku String

  name String

  description String?

  barcode String?

  salePrice Decimal @db.Decimal(12, 2)

  costPrice Decimal @db.Decimal(12, 2)

  stock Decimal @default(0) @db.Decimal(12, 3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId           String?
  supplierId           String?
  inventoryMovements   InventoryMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  branchStocks         BranchProductStock[]
  inventoryTransfers   InventoryTransfer[]
  items SaleItem[]
  returnItems          SaleReturnItem[]
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@index([categoryId])
  @@index([supplierId])
}

model ProductCategory {
  id String @id @default(cuid())

  organizationId String

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model InventoryMovement {
  id String @id @default(cuid())

  organizationId String
  productId      String
  branchId       String?

  movementType InventoryMovementType

  quantity Decimal @db.Decimal(12, 3)

  unitCost Decimal? @db.Decimal(12, 2)

  totalCost Decimal? @db.Decimal(14, 2)

  reference String?

  notes String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([branchId])
}

model PurchaseOrder {
  id String @id @default(cuid())

  organizationId String
  supplierId     String

  number String

  status PurchaseOrderStatus @default(DRAFT)

  orderDate DateTime

  expectedDate DateTime?

  notes String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)

  tax Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  organization     Organization        @relation(fields: [organizationId], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id String @id @default(cuid())

  purchaseOrderId String
  productId       String

  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @db.Decimal(18, 4)

  subtotal Decimal @db.Decimal(18, 4)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceiptItems GoodsReceiptItem[]

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id String @id @default(cuid())

  organizationId  String
  purchaseOrderId String

  number String

  receivedDate DateTime

  // Nuevo
  receivedById String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // Nuevo
  receivedBy User? @relation(fields: [receivedById], references: [id])

  items            GoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([receivedById])
}

model GoodsReceiptItem {
  id String @id @default(cuid())

  goodsReceiptId String

  purchaseOrderItemId String

  productId String

  quantityReceived Decimal @db.Decimal(18, 4)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReturnItems PurchaseReturnItem[]

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([productId])
}

model PurchaseInvoice {
  id String @id @default(cuid())

  organizationId String
  supplierId     String

  purchaseOrderId String?
  goodsReceiptId  String?

  number        String
  invoiceNumber String

  invoiceDate DateTime
  dueDate     DateTime?

  status PurchaseInvoiceStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  items PurchaseInvoiceItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseInvoiceItem {
  id String @id @default(cuid())

  purchaseInvoiceId String
  productId         String

  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @db.Decimal(18, 4)

  taxRate Decimal @default(0) @db.Decimal(5, 2)

  subtotal Decimal @db.Decimal(18, 4)
  total    Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model PurchaseReturn {
  id String @id @default(cuid())

  organizationId  String
  supplierId      String
  purchaseOrderId String
  goodsReceiptId  String?

  number String

  returnDate DateTime

  status PurchaseReturnStatus @default(DRAFT)

  reason String?
  notes  String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  items PurchaseReturnItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

model PurchaseReturnItem {
  id String @id @default(cuid())

  purchaseReturnId   String
  goodsReceiptItemId String
  productId          String

  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @db.Decimal(18, 4)

  subtotal Decimal @db.Decimal(18, 4)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])

  goodsReceiptItem GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@index([goodsReceiptItemId])
  @@index([productId])
}

model BranchProductStock {
  id String @id @default(cuid())

  branchId  String
  productId String

  stock Decimal @default(0) @db.Decimal(12, 3)
  averageCost Decimal @default(0) @db.Decimal(12, 2)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model InventoryTransfer {
  id String @id @default(cuid())

  organizationId String
  productId      String

  sourceBranchId      String
  destinationBranchId String

  quantity Decimal @db.Decimal(12, 3)

  reference String
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  sourceBranch Branch @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id])

  destinationBranch Branch @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([productId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String?

  saleNumber     String
  status         SaleStatus   @default(DRAFT)

  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)

  notes          String?
  items SaleItem[]
  saleReturns SaleReturn[]
  payments Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String

  quantity  Int      // Cantidad de unidades vendidas
  unitPrice Decimal  @db.Decimal(12, 2) // Precio de venta base
  discount  Decimal  @default(0) @db.Decimal(12, 2) // Descuento en dinero aplicado a la línea

  // Calculados automáticamente en el service
  subtotal  Decimal  @default(0) @db.Decimal(12, 2) // (quantity * unitPrice) - discount
  total     Decimal  @default(0) @db.Decimal(12, 2) // Igual al subtotal neto si no manejas IVA por ítem

  description String?  @db.VarChar(255)
  items          SaleReturnItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  saleId         String       // Factura original que se está devolviendo
  customerId     String?

  returnNumber   String
  status         SaleReturnStatus @default(DRAFT)
  returnDate     DateTime

  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)

  reason         String?      @db.VarChar(255)
  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  sale           Sale         @relation(fields: [saleId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  items          SaleReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([saleId])
}

model SaleReturnItem {
  id                 String     @id @default(cuid())
  saleReturnId       String
  saleItemId         String     // Línea de la factura original para validar cantidades
  productId          String

  quantity           Int        // Cantidad física devuelta por el cliente
  unitCost           Decimal    @db.Decimal(12, 2) // Costo recuperado de la mercancía

  notes              String?    @db.VarChar(255)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  saleReturn         SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem           SaleItem   @relation(fields: [saleItemId], references: [id])
  product            Product    @relation(fields: [productId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String        // Factura de venta que se está pagando

  method         PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(12, 2) // Dinero recibido
  reference      String?       @db.VarChar(100)   // N° de voucher o código de aprobación
  paymentDate    DateTime      @default(now())
  notes          String?       @db.VarChar(255)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([saleId])
}

model BillingResolution {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String   @unique // Una resolución activa por sucursal

  prefix         String   @db.VarChar(15)  // Ej: "OC" o "VEN"
  resolutionNumber String @db.VarChar(50)  // Número oficial de la entidad fiscal
  fromNumber     Int      // Folio inicial autorizado
  toNumber       Int      // Folio límite autorizado
  currentNumber  Int      // Consecutivo actual en el que va la sede
  expiryDate     DateTime // Fecha de vencimiento legal

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId])
}

model CashSession {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  userId         String            // Cajero responsable del turno

  status         CashSessionStatus @default(OPEN)
  openingDate    DateTime          @default(now())
  closingDate    DateTime?

  openingBalance Decimal           @db.Decimal(12, 2) // Dinero con el que inicia caja
  expectedBalance Decimal          @default(0) @db.Decimal(12, 2) // openingBalance + ventas en CASH
  actualBalance   Decimal?         @db.Decimal(12, 2) // Dinero físico real que contó el cajero
  difference      Decimal?         @db.Decimal(12, 2) // Descuadre (Faltante / Sobrante)

  notes          String?           @db.VarChar(255)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  user           User              @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
}


model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id String @id @default(cuid())

  module      String
  code        String  @unique
  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Role {
  id String @id @default(cuid())

  organizationId String

  name        String
  code        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
}

model User {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  userRoles     UserRole[]
  goodsReceipts GoodsReceipt[]
  cashSessions CashSession[]
  firstName     String
  lastName      String

  email String @unique

  passwordHash String

  phoneNumber String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  organizationId String

  firstName String
  lastName  String?

  companyName String?

  identificationType   String?
  identificationNumber String?

  email       String?
  phoneNumber String?

  address String?

  city    String?
  state   String?
  country String?

  notes String?

  isActive Boolean @default(true)
  sales Sale[]
  saleReturns SaleReturn[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([identificationNumber])
  @@index([email])
}
